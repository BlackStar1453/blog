# Mastodon配置（可选）
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
MASTODON_API_BASE_URL=https://mastodon.social

# Meilisearch配置（可选）
MEILISEARCH_URL=https://search.yourdomain.com
MEILISEARCH_API_KEY=your_search_api_key

# 其他配置
BLOG_AUTHOR=Your Name
BLOG_EMAIL=your.email@example.com

# ===================================
# 打赏功能配置
# ===================================

# Xorpay 配置（虎皮椒支付 - 用于微信支付动态二维码）
# 获取方式：从 Xorpay 账户后台获取，或从 saas-starter 项目复制
XORPAY_AID=your_xorpay_aid_here
XORPAY_SECRET=your_xorpay_secret_here

# Stripe Payment Links（美元 USD）
# 创建方式：Stripe Dashboard → 产品目录 → 创建 Payment Link
# 金额说明：$10 ≈ ¥72, $25 ≈ ¥180（按汇率 1:7.2）

# $10 USD 固定金额链接
STRIPE_LINK_10=https://donate.stripe.com/test_10usd_example

# $25 USD 固定金额链接
STRIPE_LINK_25=https://donate.stripe.com/test_25usd_example

# 自定义金额链接（最低 $10，无上限）
STRIPE_LINK_CUSTOM=https://donate.stripe.com/test_custom_example

# 网站配置（用于支付回调）
BASE_URL=https://blog-diq.pages.dev
